// Prisma schema — Nihad KP Portfolio Platform
// SQLite for dev; swap provider to "postgresql" + DATABASE_URL to Neon/Supabase for production
// (All field types are Postgres-compatible; no Json fields used by design)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  image         String?
  bio           String?
  role          String    @default("USER") // USER | ADMIN
  emailVerified DateTime?
  onboarded     Boolean   @default(false)
  banned        Boolean   @default(false)
  plan          String    @default("FREE") // FREE | PRO | BUSINESS
  planRenewsAt  DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posts        Post[]
  comments     Comment[]
  tickets      SupportTicket[]
  notification Notification[]
  activities   Activity[]
}

model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Post {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String    @default("")
  coverImage     String?
  tags           String    @default("") // comma separated
  category       String?
  published      Boolean   @default(false)
  featured       Boolean   @default(false)
  views          Int       @default(0)
  readingMinutes Int       @default(3)
  seoTitle       String?
  seoDescription String?
  authorId       String
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([published, publishedAt])
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  userId     String
  content    String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, approved])
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String   @default("")
  image        String?
  gallery      String   @default("") // pipe separated image/gif URLs
  price        Float?
  listPrice    Float?   // strikethrough original price
  currency     String   @default("INR")
  rating       Float?
  ratingCount Int?
  merchant     String?
  brand        String?
  source       String   @default("CUSTOM") // AMAZON | FLIPKART | EBAY | ALIEXPRESS | CUSTOM
  category     String   @default("General")
  affiliateUrl String
  badge        String?   // e.g. "Best Value" | "Editor's Choice"
  coupon       String?   // coupon code
  couponNote   String?   // e.g. "10% off at checkout"
  pros         String   @default("") // pipe separated
  cons         String   @default("") // pipe separated
  specs        String   @default("") // "key:value|key:value"
  buyText      String   @default("Buy Now")
  disclosure   String?
  featured     Boolean  @default(false)
  active       Boolean  @default(true)
  clicks       Int      @default(0)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, category])
}

// Media library — images, GIFs and stickers the admin uploads / links.
// Usable in blog posts, product galleries, marquee strips and ad units.
model Media {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String   @default("image") // image | gif | sticker
  alt       String?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([type])
}

// Scrolling image strip (marquee) shown on home / store / blog tops.
model MarqueeItem {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  linkUrl   String?
  badge     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Affiliate ad units — admin-controlled ad placements rendered across
// the site (home, blog list, blog article, store, services, footer).
// Either a standalone banner or a pointer to a Product (productId).
model AdUnit {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  linkUrl     String?
  productId   String?
  badge       String?
  placement   String   @default("sidebar") // home | blog-list | blog-inline | blog-sidebar | store | services | footer
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([placement, active])
}

// Admin-editable footer navigation.
model FooterLink {
  id        String   @id @default(cuid())
  section   String   @default("main") // main | explore | ventures | legal
  label     String
  url       String   @default("") // empty = hash route via client, external http(s) = new tab
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
}

// KP Foundation ventures — fully admin-editable (re-edit anything
// that has been added and will be added, per the site owner).
model Venture {
  id          String   @id @default(cuid())
  name        String
  tagline     String?
  description String   @default("")
  href        String? // external link or internal path
  icon        String   @default("foundation") // foundation | store | connect | gold | study | globe
  accent      String   @default("emerald") // emerald | amber | teal | yellow | lime
  badge       String? // e.g. "Flagship" | "Live" | "Free Service"
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Every form a visitor fills lands here so the admin sees all
// submissions with full contact details in one place.
model FormSubmission {
  id        String   @id @default(cuid())
  formType  String // contact | newsletter | inquiry | comment | support | service-inquiry
  name      String?
  email     String?
  phone     String?
  subject   String?
  message   String?
  data      String   @default("{}") // JSON blob with extra fields (budget, service, page…)
  page      String?
  status    String   @default("NEW") // NEW | READ | DONE
  createdAt DateTime @default(now())

  @@index([formType, createdAt])
  @@index([status])
}

// Unique blog view ledger — one row per post per visitor session,
// giving exact, de-duplicated view counts.
model PostView {
  id        String   @id @default(cuid())
  postId    String
  sessionId String
  createdAt DateTime @default(now())

  @@unique([postId, sessionId])
  @@index([postId])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @default("")
  icon        String   @default("sparkles")
  features    String   @default("") // pipe separated
  priceFrom   String?
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  inquiries   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inquiryRows Inquiry[]
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  serviceId String?
  budget    String?
  message   String
  status    String   @default("NEW") // NEW | READ | REPLIED | CLOSED
  source    String   @default("web")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  source    String   @default("web")
  createdAt DateTime @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  sessionId String
  device    String   @default("unknown")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  category  String   @default("general")
  priority  String   @default("normal")
  status    String   @default("OPEN") // OPEN | PENDING | RESOLVED | CLOSED
  messages  String   @default("[]") // JSON array [{from,body,at}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Setting {
  key   String @id
  value String
}

model Plan {
  id           String  @id @default(cuid())
  code         String  @unique // FREE | PRO | BUSINESS
  name         String
  priceMonthly Float   @default(0)
  currency     String  @default("INR")
  features     String  @default("") // pipe separated
  active       Boolean @default(true)
  sortOrder    Int     @default(0)
}
