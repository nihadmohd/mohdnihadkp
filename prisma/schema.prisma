// Prisma schema — Nihad KP Portfolio Platform
// SQLite for dev; swap provider to "postgresql" + DATABASE_URL to Neon/Supabase for production
// (All field types are Postgres-compatible; no Json fields used by design)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  image         String?
  bio           String?
  role          String    @default("USER") // USER | ADMIN
  emailVerified DateTime?
  onboarded     Boolean   @default(false)
  banned        Boolean   @default(false)
  plan          String    @default("FREE") // FREE | PRO | BUSINESS
  planRenewsAt  DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posts        Post[]
  comments     Comment[]
  tickets      SupportTicket[]
  notification Notification[]
  activities   Activity[]
}

model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Post {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String    @default("")
  coverImage     String?
  tags           String    @default("") // comma separated
  category       String?
  published      Boolean   @default(false)
  featured       Boolean   @default(false)
  views          Int       @default(0)
  readingMinutes Int       @default(3)
  seoTitle       String?
  seoDescription String?
  authorId       String
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([published, publishedAt])
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  userId     String
  content    String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, approved])
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String   @default("")
  image        String?
  price        Float?
  rating       Float?
  merchant     String?
  category     String   @default("General")
  affiliateUrl String
  featured     Boolean  @default(false)
  active       Boolean  @default(true)
  clicks       Int      @default(0)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, category])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @default("")
  icon        String   @default("sparkles")
  features    String   @default("") // pipe separated
  priceFrom   String?
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  inquiries   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inquiryRows Inquiry[]
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  serviceId String?
  budget    String?
  message   String
  status    String   @default("NEW") // NEW | READ | REPLIED | CLOSED
  source    String   @default("web")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  source    String   @default("web")
  createdAt DateTime @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  sessionId String
  device    String   @default("unknown")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  category  String   @default("general")
  priority  String   @default("normal")
  status    String   @default("OPEN") // OPEN | PENDING | RESOLVED | CLOSED
  messages  String   @default("[]") // JSON array [{from,body,at}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Setting {
  key   String @id
  value String
}

model Plan {
  id           String  @id @default(cuid())
  code         String  @unique // FREE | PRO | BUSINESS
  name         String
  priceMonthly Float   @default(0)
  currency     String  @default("INR")
  features     String  @default("") // pipe separated
  active       Boolean @default(true)
  sortOrder    Int     @default(0)
}
